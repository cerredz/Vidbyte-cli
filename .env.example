# Base URL of the Vidbyte public API. Defaults to https://vidbyte-backend.onrender.com when
# unset. Only loopback hosts may use cleartext http.
VIDBYTE_API_URL=https://vidbyte-backend.onrender.com

# Vidbyte API key. Must be a live key (the `vb_live_` prefix); anything else is ignored by the
# backend. This overrides stored credentials for the current shell and is never persisted
# implicitly by `vidbyte-cli login`.
VIDBYTE_API_KEY=

# Optional named profile. Equivalent to the root `--profile` option at lower precedence.
VIDBYTE_PROFILE=default

# Optional presentation and timeout overrides.
VIDBYTE_OUTPUT_FORMAT=human
VIDBYTE_COLOR=auto
VIDBYTE_REQUEST_TIMEOUT_SECONDS=30

# Used only with runtime persistence --with-x402-payment. Never passed to Codex.
VIDBYTE_X402_PRIVATE_KEY=
# Base mainnet; use eip155:84532 for Base Sepolia tests.
VIDBYTE_X402_NETWORK=eip155:8453
