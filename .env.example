# Base URL of the Vidbyte public API. Defaults to https://api.vidbyte.ai when unset.
VIDBYTE_API_URL=https://api.vidbyte.ai

# Vidbyte API key. This overrides stored credentials for the current shell and is never
# persisted implicitly by `vidbyte-cli login`.
VIDBYTE_API_KEY=

# Optional named profile. Equivalent to the root `--profile` option at lower precedence.
VIDBYTE_PROFILE=default

# Optional presentation and timeout overrides.
VIDBYTE_OUTPUT_FORMAT=human
VIDBYTE_COLOR=auto
VIDBYTE_REQUEST_TIMEOUT_SECONDS=30
